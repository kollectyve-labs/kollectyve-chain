# Optional overrides for the Hardhat project. Copy to `.env` to use.

# Ethereum JSON-RPC endpoint served by the eth-rpc proxy (scripts/dev-chain.sh).
ETH_RPC_URL=http://127.0.0.1:8545

# Deploy/test with your own key instead of the built-in dev keys.
# The default accounts are the well-known dev keys endowed in the chain's `dev`
# genesis preset (alith / baltathar). They are PUBLIC — never reuse them anywhere real.
#   alith     0xf24FF3a9CF04c71Dbc94D0b566f7A27B94566cac
#             0x5fb92d6e98884f76de468fa3f6278f8807c48bebc13595d45af5bdc4da702133
#   baltathar 0x3Cd0A705a2DC65e5b1E1205896BaA2be8A07c6e0
#             0x8075991ce870b93a8870eca0c0f91913d12f47948ca0fd25b49c6fa7cdbeee8b
# PRIVATE_KEY=0x...
